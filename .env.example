# Cloudflare Worker Secrets
# Set these via: wrangler secret put <KEY_NAME>

# Gemini API key - primary AI provider
# GEMINI_API_KEY=your_gemini_api_key
# Optional model override (defaults to gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Zhipu BigModel API key - fallback AI provider
# Format: id.secret
# ZHIPU_API_KEY=your_zhipu_api_key
# Optional model override (defaults to glm-4.7-flash)
# ZHIPU_MODEL=glm-4.7-flash

# Calendarific API key (optional) - provides additional holiday data
# CALENDARIFIC_API_KEY=your_calendarific_api_key
